---
// Hero a una pantalla: en escritorio el render ocupa todo el fondo y el texto va sobre el asfalto;
// en móvil el render queda arriba y el texto en un panel plano debajo. Siempre cabe en 100svh.
interface Cta { href: string; label: string }
interface Stat { v: string; l: string; usd?: number }
interface Props {
  title: string;
  text: string;
  primary: Cta;
  secondary?: Cta;
  stats?: Stat[];
}
import { FALLBACK_FX, fmtUsd } from "../../config/invest";
const { title, text, primary, secondary, stats = [] } = Astro.props;
---
<section id="top" class="relative flex h-svh min-h-[34rem] flex-col bg-ink-950 text-white md:justify-end md:overflow-hidden">
  <div class="relative min-h-0 flex-1 overflow-hidden md:absolute md:inset-0 md:flex-none">
    <picture>
      <source media="(max-width: 767px)" srcset="/img/electrolinera/render-estacion-m-v3.jpg" />
      <img
        src="/img/electrolinera/render-estacion-v3.jpg"
        alt="Render de una estación de carga Disart Energy con tres cargadores DC y seis vehículos eléctricos"
        width="2400" height="1102"
        class="hero-img absolute inset-x-0 bottom-0 top-[4.75rem] h-[calc(100%-4.75rem)] w-full object-cover object-[50%_20%] md:inset-0 md:h-full md:object-[50%_30%]"
        loading="eager" decoding="sync" fetchpriority="high"
      />
    </picture>
    <div class="absolute inset-x-0 bottom-0 hidden h-[72%] bg-linear-to-t from-ink-950 from-30% via-ink-950/80 to-transparent md:block"></div>
  </div>

  <div class="relative bg-ink-950 px-4 pb-5 pt-5 md:bg-transparent md:pb-10 md:pt-0">
    <div class="mx-auto max-w-6xl">
      <div class="grid gap-4 lg:grid-cols-12 lg:items-end lg:gap-14">
        <h1 class="hero-in font-display text-balance text-[1.85rem] font-extrabold leading-[1] sm:text-4xl md:text-[clamp(2.4rem,min(5.2vw,8.5svh),4.6rem)] lg:col-span-7" style="--i:0">{title}</h1>
        <div class="lg:col-span-5">
          <p class="hero-in max-w-md text-pretty text-sm leading-snug text-ink-200 md:text-base md:leading-relaxed" style="--i:1">{text}</p>
          <div class="hero-in mt-3 flex flex-wrap items-center gap-2 md:mt-5 md:gap-3" style="--i:2">
            <a href={primary.href} class="press inline-flex items-center gap-2 rounded-full bg-lime-glow px-4 py-2.5 text-[13px] font-bold sm:text-sm text-ink-950 hover:bg-white md:px-6 md:py-3.5">
              {primary.label}
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </a>
            {secondary && (
              <a href={secondary.href} class="press inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2.5 text-[13px] font-semibold sm:text-sm text-white hover:bg-white/20 md:px-6 md:py-3.5">
                {secondary.label}
              </a>
            )}
          </div>
        </div>
      </div>

      {stats.length > 0 && (
        <dl class="hero-in mt-5 grid grid-cols-3 gap-3 border-t border-white/15 pt-4 md:mt-7 md:gap-10 md:pt-5" style="--i:3">
          {stats.map((s) => (
            <div>
              <dd class="font-display whitespace-nowrap text-lg font-extrabold leading-none text-lime-glow sm:text-3xl md:text-[clamp(1.8rem,4.2svh,2.8rem)]">{s.v}</dd>
              <dt class="mt-1.5 text-[11px] leading-tight text-ink-300 sm:text-sm">{s.l}</dt>
              {s.usd && <p class="mt-0.5 hidden text-[11px] text-ink-300 md:block">≈ <span data-usd-cop={s.usd}>{fmtUsd(s.usd / FALLBACK_FX)}</span></p>}
            </div>
          ))}
        </dl>
      )}
    </div>
  </div>
</section>
