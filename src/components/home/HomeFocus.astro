---
const items = [
  {
    href: "/inversion",
    title: "Invierte en electrolineras",
    text: "Tú pones el capital y eres dueño de tu estación. Nosotros la diseñamos, instalamos, operamos y mantenemos.",
    cta: "Ver el negocio",
    img: "/img/electrolinera/render-estacion-v3.jpg",
    alt: "Render de una estación de carga Disart Energy",
    fit: "object-[50%_55%]",
  },
  {
    href: "/plataforma",
    title: "App y dashboard propios",
    text: "La app del conductor y el dashboard del socio, desarrollados por Disart. Mira las pantallas reales del sistema.",
    cta: "Ver la plataforma",
    img: "/img/plataforma/admin-inicio.webp",
    alt: "Panel de administración de Disart Energy con indicadores",
    fit: "object-top",
  },
  {
    href: "/marca-blanca",
    title: "Marca blanca para operadores",
    text: "Licenciamos la plataforma para que operes tus propias estaciones con tu app y tu backoffice, bajo tu marca.",
    cta: "Ver marca blanca",
    img: "/img/plataforma/app-inicio.webp",
    alt: "App del conductor Disart Energy",
    fit: "object-top",
  },
];
---
<section class="bg-white py-12 md:py-16">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="font-display max-w-3xl text-balance text-[1.75rem] font-extrabold leading-[1.02] text-ink-950 md:text-5xl" data-reveal>
      Tres formas de entrar al negocio de la carga.
    </h2>
    <div class="mt-8 grid gap-8 md:grid-cols-3">
      {items.map((it, i) => (
        <a href={it.href} class="focus-card group block" data-reveal style={`--i:${i}`}>
          <div class="overflow-hidden rounded-3xl bg-ink-100">
            <img src={it.img} alt={it.alt} class={`focus-img aspect-4/3 w-full object-cover ${it.fit}`} loading="lazy" />
          </div>
          <h3 class="font-display mt-5 text-balance text-2xl font-extrabold leading-tight text-ink-950">{it.title}</h3>
          <p class="mt-2 text-base leading-relaxed text-ink-700">{it.text}</p>
          <span class="mt-4 inline-flex items-center gap-2 text-sm font-bold text-brand-700">
            {it.cta}
            <svg class="h-4 w-4 transition group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .focus-img { transition: transform 600ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .focus-card:hover .focus-img { transform: scale(1.04); }
  }
</style>
