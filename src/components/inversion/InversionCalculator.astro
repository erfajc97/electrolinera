---
import {
  CAPEX_COP, INVESTOR_PCT, DISART_PCT, TARGET_HOURS, POWER_KW,
  PRICE_KWH_COP, COST_KWH_COP, fmtCopM,
} from "../../config/invest";

const presets = [
  { hours: 2, label: "Bajo · 2 h/día" },
  { hours: 4, label: "Objetivo · 4 h/día" },
  { hours: 6, label: "Alto · 6 h/día" },
];
const fmtN = (n: number) => n.toLocaleString("es-CO");
---
<section id="calculadora" class="relative overflow-hidden bg-linear-to-b from-white via-brand-50/30 to-white py-16 md:py-24">
  <div class="absolute inset-x-0 top-0 -z-10 h-72 bg-radial-fade opacity-60"></div>

  <div class="mx-auto max-w-6xl px-4"
    data-calc-config
    data-capex={CAPEX_COP}
    data-investor-pct={INVESTOR_PCT}
    data-power-kw={POWER_KW}
    data-price={PRICE_KWH_COP}
    data-cost={COST_KWH_COP}
    data-target-hours={TARGET_HOURS}
  >
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-brand-700">Calculadora de retorno</p>
      <h2 class="font-display mt-3 text-balance text-4xl font-bold tracking-tight text-ink-950 md:text-5xl">
        Simula tu inversión en tiempo real.
      </h2>
      <p class="mt-4 text-lg text-ink-700">
        Ajusta las horas de operación diarias a plena potencia. La inversión está fijada en pesos
        y el equivalente en dólares se actualiza con la tasa de cambio en vivo.
      </p>
    </div>

    <div class="mt-10 md:mt-14 grid items-start gap-8 lg:grid-cols-12" data-calc-root>
      <!-- Controls panel -->
      <div class="lg:col-span-5">
        <div class="sticky top-24 rounded-4xl border border-ink-100 bg-white p-8 shadow-soft">
          <div class="flex items-center justify-between">
            <p class="text-xs font-semibold uppercase tracking-widest text-brand-700">Tus supuestos</p>
            <div class="flex items-center gap-2 rounded-full border border-ink-100 bg-ink-50 px-3 py-1">
              <span class="h-2 w-2 rounded-full bg-brand-500 animate-pulse-soft"></span>
              <span class="text-[10px] font-semibold uppercase tracking-wider text-ink-700">
                FX <span data-fx-rate>—</span>
              </span>
            </div>
          </div>

          <div class="mt-8">
            <div class="flex items-baseline justify-between">
              <label for="calc-hours" class="text-sm font-semibold text-ink-950">Horas a plena potencia / día</label>
              <span class="font-display text-3xl font-bold text-brand-700">
                <span data-calc-hours-value>{TARGET_HOURS}</span><span class="text-base font-medium text-ink-500">h</span>
              </span>
            </div>
            <input
              id="calc-hours"
              type="range"
              min="1"
              max="12"
              step="1"
              value={TARGET_HOURS}
              class="calc-range mt-3 w-full"
              data-calc-hours
            />
            <div class="mt-2 flex justify-between text-[10px] font-medium text-ink-500">
              <span>1 h</span><span>6 h</span><span>12 h</span>
            </div>
            <div class="mt-4 flex flex-wrap gap-2">
              {presets.map((p) => (
                <button
                  type="button"
                  data-calc-preset={p.hours}
                  class="rounded-full border border-ink-200 bg-white px-3 py-1.5 text-xs font-semibold text-ink-700 transition hover:border-brand-400 hover:text-brand-700"
                >
                  {p.label}
                </button>
              ))}
            </div>
          </div>

          <div class="mt-8 border-t border-ink-100 pt-6">
            <p class="text-[10px] font-semibold uppercase tracking-widest text-ink-500">Constantes del modelo</p>
            <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-xs">
              <dt class="text-ink-700">Potencia instalada</dt><dd class="font-semibold text-ink-950 text-right">{POWER_KW} kW</dd>
              <dt class="text-ink-700">Compra kWh</dt><dd class="font-semibold text-ink-950 text-right">${fmtN(COST_KWH_COP)} COP</dd>
              <dt class="text-ink-700">Venta kWh</dt><dd class="font-semibold text-ink-950 text-right">${fmtN(PRICE_KWH_COP)} COP</dd>
              <dt class="text-ink-700">Inversionista</dt><dd class="font-semibold text-ink-950 text-right">{INVESTOR_PCT}%</dd>
              <dt class="text-ink-700">Disart (operación)</dt><dd class="font-semibold text-ink-950 text-right">{DISART_PCT}%</dd>
              <dt class="text-ink-700">Inversión</dt><dd class="font-semibold text-ink-950 text-right">{fmtCopM(CAPEX_COP)}</dd>
            </dl>
          </div>
        </div>
      </div>

      <!-- Outputs panel -->
      <div class="lg:col-span-7 space-y-5">
        <!-- Investment summary -->
        <div class="rounded-4xl border border-brand-200 bg-linear-to-br from-ink-950 via-ink-900 to-brand-900 p-8 text-white shadow-glow">
          <div class="flex items-center justify-between gap-4">
            <p class="text-xs font-semibold uppercase tracking-widest text-brand-200">Tu inversión</p>
            <span class="rounded-full bg-white/10 px-3 py-1 text-[10px] font-semibold uppercase tracking-widest text-brand-100 backdrop-blur" data-calc-scenario>Escenario objetivo</span>
          </div>

          <div class="mt-4 grid items-baseline gap-2 sm:grid-cols-[auto_1fr] sm:gap-4">
            <p class="font-display text-5xl font-bold leading-none md:text-6xl">{fmtCopM(CAPEX_COP)}</p>
            <p class="text-base text-ink-300">≈ <span data-calc-investment-usd>USD 206.250</span></p>
          </div>
          <p class="mt-3 text-sm text-ink-300">
            Eres dueño del <strong class="font-semibold text-lime-glow">{INVESTOR_PCT}%</strong> de los equipos
            y recibes el <strong class="font-semibold text-lime-glow">{INVESTOR_PCT}%</strong> del resultado distribuible.
            Disart opera la estación por el {DISART_PCT}% restante.
          </p>
        </div>

        <!-- Monthly returns -->
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="rounded-3xl border border-ink-100 bg-white p-6 shadow-soft">
            <p class="text-[10px] font-bold uppercase tracking-widest text-brand-700">Ventas de energía / mes</p>
            <p class="font-display mt-3 text-3xl font-bold text-ink-950" data-calc-sales-cop>$ 155.520.000 COP</p>
            <p class="mt-1 text-sm text-ink-500" data-calc-sales-usd>USD 48.600</p>
            <p class="mt-3 text-xs text-ink-500">
              Ingresos de la estación completa. Resultado distribuible tras energía:
              <span class="font-semibold text-ink-700" data-calc-margin-cop>$ 86.400.000 COP</span>.
            </p>
          </div>

          <div class="rounded-3xl border border-brand-200 bg-brand-50/60 p-6 shadow-soft ring-1 ring-inset ring-brand-200">
            <p class="text-[10px] font-bold uppercase tracking-widest text-brand-700">Tu {INVESTOR_PCT}% / mes</p>
            <p class="font-display mt-3 text-3xl font-bold text-brand-800" data-calc-utility-cop>$ 60.480.000 COP</p>
            <p class="mt-1 text-sm text-brand-700" data-calc-utility-usd>USD 18.900</p>
            <p class="mt-3 text-xs text-ink-700">
              Disart ({DISART_PCT}%): <span class="font-semibold" data-calc-disart-cop>$ 25.920.000 COP</span>
              por operar, mantener y proteger la estación.
            </p>
          </div>
        </div>

        <!-- Annual + payback -->
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="rounded-3xl border border-ink-100 bg-white p-6 shadow-soft">
            <p class="text-[10px] font-bold uppercase tracking-widest text-brand-700">Tu utilidad anual</p>
            <p class="font-display mt-3 text-3xl font-bold text-ink-950" data-calc-annual-cop>$ 725.760.000 COP</p>
            <p class="mt-1 text-sm text-ink-500" data-calc-annual-usd>USD 226.800</p>
            <p class="mt-3 text-xs text-ink-500">Tu participación sobre el resultado distribuible de los 12 meses.</p>
          </div>

          <div class="rounded-3xl border border-lime-glow/40 bg-linear-to-br from-lime-glow/20 to-brand-50 p-6 shadow-soft">
            <p class="text-[10px] font-bold uppercase tracking-widest text-brand-700">Payback proyectado</p>
            <p class="font-display mt-3 text-3xl font-bold text-brand-900">
              <span data-calc-payback>10.9</span><span class="ml-1 text-base font-semibold text-ink-700">meses</span>
            </p>
            <p class="mt-3 text-xs text-ink-700">Tiempo para recuperar la inversión a las horas seleccionadas.</p>
          </div>
        </div>

        <p class="text-center text-xs text-ink-500">
          Proyección ilustrativa; no garantiza ingresos ni rentabilidad. Antes de impuestos aplicables.
          Depende de demanda real, potencia entregada, disponibilidad de equipos y tarifa eléctrica.
          Los valores en USD varían con la tasa de cambio; la inversión es fija en pesos.
        </p>

        <div class="text-center">
          <a href="#contacto" class="inline-flex items-center gap-1.5 rounded-full bg-ink-950 px-6 py-3.5 text-sm font-semibold text-white transition hover:bg-brand-700">
            Hablar con un asesor
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .calc-range {
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    height: 28px;
    width: 100%;
  }
  .calc-range::-webkit-slider-runnable-track {
    height: 6px;
    border-radius: 9999px;
    background: linear-gradient(
      to right,
      oklch(0.55 0.17 152) 0%,
      oklch(0.55 0.17 152) var(--calc-fill, 50%),
      oklch(0.94 0.01 160) var(--calc-fill, 50%),
      oklch(0.94 0.01 160) 100%
    );
  }
  .calc-range::-moz-range-track {
    height: 6px;
    border-radius: 9999px;
    background: oklch(0.94 0.01 160);
  }
  .calc-range::-moz-range-progress {
    height: 6px;
    border-radius: 9999px;
    background: oklch(0.55 0.17 152);
  }
  .calc-range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 24px;
    height: 24px;
    border-radius: 9999px;
    background: white;
    border: 4px solid oklch(0.46 0.14 152);
    box-shadow: 0 4px 12px oklch(0.55 0.17 152 / 0.4);
    margin-top: -9px;
    cursor: grab;
    transition: transform 0.15s ease;
  }
  .calc-range::-webkit-slider-thumb:active { cursor: grabbing; transform: scale(1.1); }
  .calc-range::-moz-range-thumb {
    width: 24px;
    height: 24px;
    border-radius: 9999px;
    background: white;
    border: 4px solid oklch(0.46 0.14 152);
    box-shadow: 0 4px 12px oklch(0.55 0.17 152 / 0.4);
    cursor: grab;
  }
  .calc-range:focus {
    outline: none;
  }
  .calc-range:focus::-webkit-slider-thumb {
    box-shadow: 0 0 0 4px oklch(0.88 0.10 152 / 0.5);
  }
</style>

<script>
  const DAYS_PER_MONTH = 30;
  const FALLBACK_FX = 3200;

  const cfg = document.querySelector<HTMLElement>('[data-calc-config]');
  const root = document.querySelector<HTMLElement>('[data-calc-root]');
  if (cfg && root) {
    const CAPEX_COP = Number(cfg.dataset.capex);
    const INVESTOR_SHARE = Number(cfg.dataset.investorPct) / 100;
    const POWER_KW = Number(cfg.dataset.powerKw);
    const PRICE_KWH_COP = Number(cfg.dataset.price);
    const COST_KWH_COP = Number(cfg.dataset.cost);
    const TARGET_HOURS = Number(cfg.dataset.targetHours);

    const $ = (sel: string) => root.querySelector<HTMLElement>(sel)!;
    const hoursInput = root.querySelector<HTMLInputElement>('[data-calc-hours]')!;
    const hoursVal = $('[data-calc-hours-value]');
    const fxBadge = $('[data-fx-rate]');
    const scenarioBadge = $('[data-calc-scenario]');
    const investUsdEl = $('[data-calc-investment-usd]');
    const salesCopEl = $('[data-calc-sales-cop]');
    const salesUsdEl = $('[data-calc-sales-usd]');
    const marginCopEl = $('[data-calc-margin-cop]');
    const utilCopEl = $('[data-calc-utility-cop]');
    const utilUsdEl = $('[data-calc-utility-usd]');
    const disartCopEl = $('[data-calc-disart-cop]');
    const annCopEl = $('[data-calc-annual-cop]');
    const annUsdEl = $('[data-calc-annual-usd]');
    const paybackEl = $('[data-calc-payback]');
    const presetBtns = root.querySelectorAll<HTMLButtonElement>('[data-calc-preset]');

    const fmtCop = (n: number) =>
      '$ ' + Math.round(n).toLocaleString('es-CO').replace(/,/g, '.') + ' COP';
    const fmtUsd = (n: number) => 'USD ' + Math.round(n).toLocaleString('en-US');
    const fmtFx = (n: number) =>
      'USD = $' + Math.round(n).toLocaleString('es-CO').replace(/,/g, '.');

    const setFill = (el: HTMLInputElement) => {
      const min = Number(el.min);
      const max = Number(el.max);
      const val = Number(el.value);
      el.style.setProperty('--calc-fill', ((val - min) / (max - min)) * 100 + '%');
    };

    const state = { hours: Number(hoursInput.value) || TARGET_HOURS, fxCop: FALLBACK_FX };

    function compute(hours: number) {
      const kwhMonth = POWER_KW * hours * DAYS_PER_MONTH;
      const salesMonth = kwhMonth * PRICE_KWH_COP;
      const marginMonth = kwhMonth * (PRICE_KWH_COP - COST_KWH_COP);
      const investorMonth = marginMonth * INVESTOR_SHARE;
      const disartMonth = marginMonth - investorMonth;
      return {
        salesMonth,
        marginMonth,
        investorMonth,
        disartMonth,
        investorYear: investorMonth * 12,
        paybackMonths: investorMonth > 0 ? CAPEX_COP / investorMonth : Infinity,
      };
    }

    function scenarioLabel(hours: number) {
      if (hours < TARGET_HOURS) return 'Escenario bajo · ' + hours + ' h/día';
      if (hours === TARGET_HOURS) return 'Escenario objetivo · ' + hours + ' h/día';
      return 'Escenario alto · ' + hours + ' h/día';
    }

    function render() {
      const r = compute(state.hours);
      const fx = state.fxCop;
      hoursVal.textContent = String(state.hours);
      scenarioBadge.textContent = scenarioLabel(state.hours);
      fxBadge.textContent = fmtFx(fx);

      investUsdEl.textContent = fmtUsd(CAPEX_COP / fx);

      salesCopEl.textContent = fmtCop(r.salesMonth);
      salesUsdEl.textContent = fmtUsd(r.salesMonth / fx);
      marginCopEl.textContent = fmtCop(r.marginMonth);

      utilCopEl.textContent = fmtCop(r.investorMonth);
      utilUsdEl.textContent = fmtUsd(r.investorMonth / fx);
      disartCopEl.textContent = fmtCop(r.disartMonth);

      annCopEl.textContent = fmtCop(r.investorYear);
      annUsdEl.textContent = fmtUsd(r.investorYear / fx);

      if (!isFinite(r.paybackMonths) || r.paybackMonths < 0) {
        paybackEl.textContent = '—';
      } else if (r.paybackMonths > 99) {
        paybackEl.textContent = '99+';
      } else {
        paybackEl.textContent = r.paybackMonths.toFixed(1);
      }

      setFill(hoursInput);
    }

    hoursInput.addEventListener('input', () => {
      state.hours = Number(hoursInput.value);
      render();
    });
    presetBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const h = Number(btn.dataset.calcPreset);
        if (Number.isFinite(h)) {
          state.hours = h;
          hoursInput.value = String(h);
          render();
        }
      });
    });

    render();

    fetch('/api/fx')
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((data) => {
        const cop = Number(data?.cop);
        if (Number.isFinite(cop) && cop > 0) {
          state.fxCop = cop;
          render();
        }
      })
      .catch(() => { /* keep fallback */ });
  }
</script>
