---
import { INVESTOR_PCT, DISART_PCT } from "../../config/invest";
import servicios from "../../config/servicios-30.json";

const fases = [...new Set(servicios.map((x) => x.fase))].map((fase, i) => ({
  fase,
  idx: i + 1,
  items: servicios.filter((x) => x.fase === fase),
}));

const noExtraCharge = [
  "Software y app",
  "Pasarela y cobros",
  "Administración",
  "Monitoreo 24/7",
  "Soporte a conductores",
  "Mantenimiento ordinario",
];

const kpis = [
  { v: String(servicios.length), l: "servicios a cargo de Disart" },
  { v: String(fases.length), l: "fases: de la importación a la operación" },
  { v: "24/7", l: "monitoreo y soporte" },
  { v: "1", l: "solo responsable de punta a punta" },
];
---
<section id="cobertura" class="relative isolate overflow-hidden bg-ink-950 py-16 text-white md:py-24">
  <div class="pointer-events-none absolute inset-0 -z-10 opacity-70 [background-image:radial-gradient(55%_45%_at_15%_0%,oklch(0.55_0.17_152_/_0.35),transparent_70%),radial-gradient(45%_40%_at_90%_30%,oklch(0.88_0.20_130_/_0.12),transparent_70%)]"></div>
  <span class="pointer-events-none absolute -right-6 top-6 -z-10 select-none font-display text-[16rem] font-bold leading-none text-white/[0.03] md:text-[22rem]" aria-hidden="true">{DISART_PCT}%</span>

  <div class="mx-auto max-w-6xl px-4">
    <div class="grid items-end gap-8 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <p class="text-xs font-semibold uppercase tracking-widest text-lime-glow">Qué cubre el {DISART_PCT}% de Disart</p>
        <h2 class="font-display mt-3 text-balance text-4xl font-bold tracking-tight md:text-5xl">
          Un solo operador para todo el ciclo del negocio.
        </h2>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-200 md:text-lg">
          Sin Disart, tendrías que contratar y coordinar por tu cuenta a un importador, un gestor de permisos,
          un constructor, un proveedor de software, una pasarela de pagos, un centro de monitoreo, técnicos de
          mantenimiento y un equipo de seguridad informática. Con Disart es un solo responsable y un solo reparto.
        </p>
      </div>
      <dl class="grid grid-cols-2 gap-3 lg:col-span-4">
        {kpis.map((k) => (
          <div class="rounded-2xl border border-white/10 bg-white/5 p-4 backdrop-blur">
            <dt class="font-display text-3xl font-bold text-lime-glow">{k.v}</dt>
            <dd class="mt-1 text-[11px] leading-snug text-ink-300">{k.l}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="mt-10 flex items-center justify-between gap-4">
      <p class="text-xs text-ink-300">Toca cada servicio para ver exactamente qué incluye.</p>
      <button type="button" data-cob-toggle class="shrink-0 rounded-full border border-white/20 px-4 py-2 text-xs font-semibold text-white transition hover:bg-white/10">
        Expandir todo
      </button>
    </div>

    <div class="mt-6 space-y-10" data-cob-root>
      {fases.map((f) => (
        <div>
          <div class="flex items-center gap-4">
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-lime-glow font-display text-sm font-bold text-ink-950">{f.idx}</span>
            <div class="min-w-0 flex-1">
              <p class="font-display text-lg font-bold md:text-xl">{f.fase}</p>
              <p class="text-xs text-ink-300">{f.items.length} servicios</p>
            </div>
            <span class="hidden h-px flex-1 bg-white/10 sm:block"></span>
          </div>

          <div class="mt-4 space-y-3">
            {f.items.map((g, j) => (
              <details class="group rounded-2xl border border-white/10 bg-white/5 transition open:border-brand-400/50 open:bg-white/[0.08]" open={f.idx === 1 && j === 0}>
                <summary class="flex cursor-pointer list-none items-start gap-4 p-5 [&::-webkit-details-marker]:hidden">
                  <span class="mt-0.5 font-display text-sm font-bold text-brand-300">{String(g.n).padStart(2, "0")}</span>
                  <span class="min-w-0 flex-1">
                    <span class="block font-display text-base font-semibold md:text-lg">{g.title}</span>
                    <span class="mt-1 block text-sm leading-relaxed text-ink-300 group-open:hidden">{g.summary}</span>
                  </span>
                  <span class="mt-1 grid h-7 w-7 shrink-0 place-items-center rounded-full bg-white/10 text-brand-200 transition group-open:rotate-45 group-open:bg-lime-glow group-open:text-ink-950">
                    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                  </span>
                </summary>
                <div class="px-5 pb-5 pl-[3.25rem]">
                  <p class="text-sm leading-relaxed text-ink-200">{g.summary}</p>
                  <ul class="mt-4 grid gap-x-6 gap-y-2 sm:grid-cols-2">
                    {g.items.map((i) => (
                      <li class="flex items-start gap-2 text-[13px] leading-relaxed text-ink-100">
                        <svg class="mt-0.5 h-4 w-4 shrink-0 text-lime-glow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                        {i}
                      </li>
                    ))}
                  </ul>
                </div>
              </details>
            ))}
          </div>
        </div>
      ))}
    </div>

    <div class="mt-12 rounded-3xl border border-lime-glow/30 bg-linear-to-br from-lime-glow/10 to-brand-500/10 p-6 md:p-8">
      <div class="grid items-center gap-6 md:grid-cols-12">
        <div class="md:col-span-5">
          <p class="font-display text-5xl font-bold text-lime-glow md:text-6xl">{INVESTOR_PCT}%</p>
          <p class="mt-2 font-display text-xl font-bold">Tu parte llega limpia.</p>
          <p class="mt-1 text-sm text-ink-200">Todo lo anterior está cubierto por el {DISART_PCT}% de Disart. No se te cobra aparte.</p>
        </div>
        <div class="md:col-span-7">
          <div class="flex flex-wrap gap-2">
            {noExtraCharge.map((n) => (
              <span class="rounded-full border border-white/15 bg-white/10 px-3 py-1.5 text-xs font-semibold text-white">
                <span class="text-lime-glow">✓</span> {n}
              </span>
            ))}
          </div>
          <p class="mt-4 text-[11px] leading-relaxed text-ink-300">
            Gastos extraordinarios (reposición de equipos principales, ampliaciones de infraestructura o daños
            no cubiertos por garantía) se regulan expresamente en el contrato.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-cob-root]');
  const btn = document.querySelector<HTMLButtonElement>('[data-cob-toggle]');
  if (root && btn) {
    const all = () => Array.from(root.querySelectorAll<HTMLDetailsElement>('details'));
    const sync = () => {
      btn.textContent = all().every((d) => d.open) ? 'Colapsar todo' : 'Expandir todo';
    };
    btn.addEventListener('click', () => {
      const open = !all().every((d) => d.open);
      all().forEach((d) => (d.open = open));
      sync();
    });
    root.addEventListener('toggle', sync, true);
    sync();
  }
</script>
