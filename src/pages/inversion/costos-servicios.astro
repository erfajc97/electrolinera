---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import SubHero from "../../components/shared/SubHero.astro";
import NextStep from "../../components/shared/NextStep.astro";
import InversionCobertura30 from "../../components/inversion/InversionCobertura30.astro";
import CTA from "../../components/CTA.astro";
import Footer from "../../components/Footer.astro";
import WhatsAppFab from "../../components/WhatsAppFab.astro";
import { DISART_PCT } from "../../config/invest";
import servicios from "../../config/servicios-30.json";

const meta = {
  title: "Costos de nuestros servicios para tu electrolinera | Disart Energy",
  description:
    "Importación, permisos, obra, app propia, dashboard del socio, monitoreo 24/7, soporte y mantenimiento: los servicios incluidos en la operación de tu electrolinera.",
};
const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Inicio", item: "https://disartenergy.com/" },
      { "@type": "ListItem", position: 2, name: "Inversión", item: "https://disartenergy.com/inversion" },
      { "@type": "ListItem", position: 3, name: "Costos de nuestros servicios", item: "https://disartenergy.com/inversion/costos-servicios" },
    ],
  },
];
---
<BaseLayout title={meta.title} description={meta.description} jsonld={jsonld}>
  <Nav />
  <WhatsAppFab />
  <main>
    <SubHero
      current="cobertura"
      title="Costos de nuestros servicios."
      lead={`${servicios.length} servicios, desde importar los equipos hasta mantenerlos funcionando todos los días. Todo está incluido, sin cobros adicionales.`}
    />
    <InversionCobertura30 />
    <NextStep current="cobertura" />
    <CTA />
  </main>
  <Footer />
</BaseLayout>
